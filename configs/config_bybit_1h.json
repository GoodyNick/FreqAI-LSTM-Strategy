  "freqai": {
      "enabled": true,
      "identifier": "torch-lstm-1h",
      "train_period_days": 180,
      "fit_live_predictions_candles": 4,
      "force_model_refresh": false,
      "continual_learning": false,
      "backtest_period_days": 30,
      "expiration_hours": 48,
      "live_retrain_hours": 24,
      "purge_old_models": 2,
      "save_backtest_models": true,
      "write_metrics_to_disk": true,
      "activate_tensorboard": false,
      "feature_parameters": {
          "include_corr_pairlist": [
              // "BTC/USDT:USDT",
              // "ETH/USDT:USDT",
              // "LTC/USDT:USDT",
              // "BNB/USDT:USDT",
              // "DOT/USDT:USDT",
              // "SOL/USDT:USDT",
              // "LINK/USDT:USDT",
              // "AVAX/USDT:USDT",
              // "DOGE/USDT:USDT",
              // "TON/USDT:USDT"
          ],
          "include_timeframes": [
              "1h",
              "4h"
          ],
          "label_period_candles": 12,
          "include_shifted_candidates": 12,
          "DI_threshold": 1.0,
          "weight_factor": 0.4,
          "principal_component_analysis": true,
          "num_pca_components": 15,
          "use_SVM_to_remove_outliers": true, 
          "use_DBSCAN_to_remove_outliers": false,     
          "indicator_periods_candles": [5, 20, 50],
          "plot_feature_importances": 0,
          "noise_standard_deviation": 0.01,
          "buffer_train_data_candles": 20,
          "scale_features": "standard"  // Normalization type (standard/scaled)
      },
      "data_split_parameters": {
          "test_size": 0.30,
          "random_state": 42,
          "shuffle": true
      },
      "model_training_parameters": {
          "learning_rate": 0.0005,
          "weight_decay": 0.0005,
          "use_gpu": true,
          "enable_feature_importance": false,
          "enable_early_stopping": true,
          "early_stopping_patience": 5,
          "loss_function": "mae",
          "trainer_kwargs": {
              "batch_size": 128,
              "n_epochs": 50
          }
      },
      "model_kwargs": {
          "num_lstm_layers": 3,
          "hidden_dim": 128,
          "dropout_percent": 0.3,
          "window_size": 48,  // ✅ Matches sequence input size for LSTM
          "input_dim": 200,    // ✅ Defines how many features per timestep
          "output_dim": 1,     // ✅ Single-value regression prediction
          "activation_function": "relu" // ✅ Added activation function for LSTM
      }
  },
